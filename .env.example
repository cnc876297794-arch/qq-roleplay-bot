# =============================================================================
# QQ Roleplay Bot - 环境变量配置模板
# =============================================================================
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 在 .env 中填入真实值（.env 已被 .gitignore 排除，不会被提交）
#   3. 在启动前加载：       set -a && source .env && set +a
# =============================================================================

# ───── NoneBot 运行时 ─────
# Web 驱动（推荐 fastapi + aiohttp）
DRIVER=~fastapi+~aiohttp
# NoneBot 监听地址与端口
HOST=0.0.0.0
PORT=8080
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 超级用户 QQ 号列表（JSON 数组格式）
SUPERUSER=["123456789"]
# 命令前缀
COMMAND_START=["/"]

# ───── OneBot v11 接入 ─────
# 形如 {"<机器人QQ号>": "http://127.0.0.1:<napcat_http_port>/"}
# 这里的 QQ 号必须与 NapCat 登录的小号一致
ONEBOT_API_ROOTS={"123456789":"http://127.0.0.1:3002/"}

# ───── DeepSeek API（必填）─────
# 在 https://platform.deepseek.com 控制台创建
DEEPSEEK_API_KEY=sk-your-key-here

# ───── 调试开关 ─────
# 设为 1 时，每次发往 LLM 的完整 prompt 会写到 data/last_llm_prompt.json
# 设为 0 或注释掉关闭（生产环境建议关闭，避免磁盘 IO 与隐私泄露）
QQBOT_DUMP_LLM_PROMPT=0
